{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowUnusedLabels": false,
    "noErrorTruncation": true,
    "types": ["node"]
  },
  "include": [
    "next.config.ts",
    "prisma.config.ts",
    "oxlint.config.ts",
    "oxfmt.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
